# ─── UHQ.Monster Reseller Addon — Variables d'environnement ───────────────────
# Embarqué dans le panel, tout est fourni automatiquement (PORT, PANEL_URL, PANEL_API_KEY, DB_PATH).
# La clé API UHQ.Monster se saisit dans l'interface : Extensions → UHQ.Monster Reseller → Paramètres.

# Port du microservice (par défaut : 3001)
PORT=3001

# URL du panel UHQ (les administrateurs y sont vérifiés, les proxies y sont importés)
PANEL_URL=http://localhost:8000

# Clé API du panel (même valeur que pour les autres addons) : protège l'export/import de sauvegarde
PANEL_API_KEY=

# Fichier de données (clé API revendeur, correspondances proxy → catégorie, historique)
DB_PATH=./data/reseller-data.json

# Tests uniquement : remplace l'URL de l'API UHQ.Monster (jamais nécessaire en production)
# UHQ_API_BASE=https://uhq.monster/api/v2/reseller

NODE_ENV=development
